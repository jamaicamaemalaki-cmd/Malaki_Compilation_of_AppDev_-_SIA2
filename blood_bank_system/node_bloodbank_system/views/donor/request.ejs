<h1 class="h3 mb-3">Request Donation Schedule</h1>
<form class="soft-card p-4" method="post" action="/donor/request">
  <div class="row g-3">
    <%- include('../partials/facility-selects', { facilities, formData, categoryLabel: 'Facility Category', facilityLabel: 'Facility Name' }) %>
    <div class="col-md-4">
      <label class="form-label">Component</label>
      <select class="form-select" name="component" required><% components.forEach((c) => { %><option value="<%= c %>" <%= formData.component === c ? 'selected' : '' %>><%= c %></option><% }) %></select>
    </div>
    <div class="col-md-4">
      <label class="form-label">Units</label>
      <input class="form-control" type="number" name="units" min="1" max="2" value="<%= formData.units || 1 %>" required>
    </div>
    <div class="col-md-12">
      <label class="form-label">Note</label>
      <textarea class="form-control" name="donor_note"><%= formData.donor_note || '' %></textarea>
    </div>
  </div>
  <button class="btn btn-danger btn-lg mt-4">Submit Request</button>
</form>
