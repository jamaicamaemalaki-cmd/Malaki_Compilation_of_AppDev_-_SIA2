<h1 class="h3 mb-3">Requests Addressed To <%= facility.facility_name %></h1>
<div class="surface table-responsive"><table class="table align-middle"><thead><tr><th>Requester</th><th>Blood</th><th>Units</th><th>Urgency</th><th>Status</th><th>Action</th></tr></thead><tbody><% requests.forEach((r) => { %><tr><td><%= r.requester_facility || r.requester_name || 'Facility' %></td><td><%= r.blood_type %> <%= r.component %></td><td><%= r.units %></td><td><%= r.urgency %></td><td><%= r.status %></td><td><form class="d-flex gap-2" method="post" action="/facility/addressed-requests/<%= r.id %>?_method=PATCH"><select class="form-select form-select-sm" name="status"><option value="approved">approved</option><option value="rejected">rejected</option></select><input class="form-control form-control-sm" name="admin_note" placeholder="Note"><button class="btn btn-sm btn-danger">Save</button></form></td></tr><% }) %><% if (!requests.length) { %><tr><td colspan="6" class="text-center text-muted">No incoming requests.</td></tr><% } %></tbody></table></div>
