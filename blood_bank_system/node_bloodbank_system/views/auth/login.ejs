<div class="auth-shell">
  <div class="soft-card auth-card p-4 p-md-5">
    <div class="text-center mb-4">
      <i class="bi bi-droplet-fill fs-2 text-danger"></i>
      <h1>Login</h1>
      <p class="text-secondary mb-0">Access your BloodLink workspace.</p>
    </div>
    <form method="post" action="/login">
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input class="form-control" type="email" name="email" value="<%= formData.email || '' %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Password</label>
        <div class="input-group">
          <input id="loginPassword" class="form-control" type="password" name="password" required>
          <button class="btn btn-outline-danger" type="button" data-toggle-password="#loginPassword"><i class="bi bi-eye"></i></button>
        </div>
      </div>
      <button class="btn btn-danger btn-lg w-100 mt-2">Login</button>

    </form>
  </div>
</div>
