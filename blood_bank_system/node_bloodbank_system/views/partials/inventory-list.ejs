<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Facility</th><th>Blood</th><th>Component</th><th>Units</th></tr></thead><tbody><% inventories.forEach((item) => { %><tr><td><%= item.facility_name || 'Facility' %></td><td><span class="badge text-bg-danger"><%= item.blood_type %></span></td><td><%= item.component %></td><td><%= item.units_available %></td></tr><% }) %><% if (!inventories.length) { %><tr><td colspan="4" class="text-center text-muted py-3">No inventory records.</td></tr><% } %></tbody></table></div>
