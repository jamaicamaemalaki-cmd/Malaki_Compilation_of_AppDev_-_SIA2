<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Facility</th><th>Blood</th><th>Units</th><th>Urgency</th><th>Status</th><th>Note</th></tr></thead><tbody><% requests.forEach((r) => { %><tr><td><%= r.facility_name || r.requester_facility || 'Facility' %></td><td><%= r.blood_type %> <%= r.component %></td><td><%= r.units %></td><td><%= r.urgency %></td><td><span class="badge text-bg-secondary"><%= r.status %></span></td><td><%= r.admin_note || r.reason || '' %></td></tr><% }) %><% if (!requests.length) { %><tr><td colspan="6" class="text-center text-muted py-3">No requests.</td></tr><% } %></tbody></table></div>
